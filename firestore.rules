rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update: if isValidId(settingId)
        && incoming().companyName is string && incoming().companyName.size() <= 100
        && incoming().currency is string && incoming().currency.size() <= 10;
      allow delete: if false;
    }

    // Chart of Accounts
    match /accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId)
        && incoming().code is string && incoming().code.size() <= 20
        && incoming().type in ['asset', 'liability', 'equity', 'revenue', 'cogs', 'expense'];
      allow delete: if false;
    }

    // Journal Entries (Immutable once posted)
    match /journalEntries/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId)
        && incoming().entryNumber is string && incoming().entryNumber.size() <= 30
        && incoming().totalAmount is number
        && incoming().lines is list && incoming().lines.size() <= 100;
      allow update, delete: if false; // Strict double-entry immutability
    }

    // Garment & Abaya Models
    match /models/{modelId} {
      allow read: if true;
      allow create, update: if isValidId(modelId)
        && incoming().modelCode is string && incoming().modelCode.size() <= 50
        && incoming().nameAr is string && incoming().nameAr.size() <= 100;
      allow delete: if isValidId(modelId);
    }

    // Atelier Production Orders
    match /productionOrders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId)
        && incoming().orderNumber is string && incoming().orderNumber.size() <= 30
        && incoming().currentStage in ['New', 'Cutting', 'Sewing', 'Embroidery', 'Ironing', 'Ready', 'Delivered'];
      allow delete: if isValidId(orderId);
    }

    // Warehouse Inventory Items
    match /inventoryItems/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId)
        && incoming().sku is string && incoming().sku.size() <= 50
        && incoming().nameAr is string && incoming().nameAr.size() <= 100;
      allow delete: if isValidId(itemId);
    }

    // Stock Movement Audit Log (Immutable writes)
    match /stockMovements/{movementId} {
      allow read: if true;
      allow create: if isValidId(movementId)
        && incoming().movementNumber is string && incoming().movementNumber.size() <= 30
        && incoming().quantity is number;
      allow update, delete: if false;
    }

    // Sales & Tax Invoices
    match /salesInvoices/{invoiceId} {
      allow read: if true;
      allow create, update: if isValidId(invoiceId)
        && incoming().invoiceNumber is string && incoming().invoiceNumber.size() <= 30
        && incoming().grandTotal is number;
      allow delete: if false;
    }

    // Customers
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if isValidId(customerId)
        && incoming().code is string && incoming().code.size() <= 30
        && incoming().name is string && incoming().name.size() <= 100;
      allow delete: if isValidId(customerId);
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if true;
      allow create, update: if isValidId(supplierId)
        && incoming().code is string && incoming().code.size() <= 30
        && incoming().companyName is string && incoming().companyName.size() <= 100;
      allow delete: if isValidId(supplierId);
    }

    // Employees
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId)
        && incoming().empCode is string && incoming().empCode.size() <= 30
        && incoming().fullName is string && incoming().fullName.size() <= 100;
      allow delete: if isValidId(employeeId);
    }
  }
}
